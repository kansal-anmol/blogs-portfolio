{
	"name": "hashnode-blog-enterprise",
	"version": "1.0.0",
	"description": "Enterprise blog theme using Hashnode Public APIs",
	"scripts": {
		"build": "next build",
		"codegen": "graphql-codegen --config codegen.yml",
		"dev": "concurrently \"next\" \"pnpm codegen --watch\" --names next,codegen",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json}\"",
		"lint": "next lint --dir components --dir pages --dir utils --dir lib",
		"start": "next start",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "^3.2.0",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@tailwindcss/typography": "^0.5.19",
		"@types/slug": "^5.0.9",
		"@vercel/og": "^0.11.1",
		"classnames": "^2.5.1",
		"date-fns": "^4.3.0",
		"graphql-request": "^7.4.0",
		"gray-matter": "^4.0.3",
		"html-react-parser": "^6.1.2",
		"js-base64": "^3.7.8",
		"js-cookie": "^3.0.7",
		"next": "^16.2.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-icons": "^5.6.0",
		"react-image-gallery": "^2.1.2",
		"react-waypoint": "^10.3.0",
		"remark": "^15.0.1",
		"remark-html": "^16.0.1",
		"rss": "^1.2.2",
		"sanitize-html": "^2.17.4",
		"slug": "^11.0.1",
		"tailwind-merge": "^3.6.0",
		"uuid": "^14.0.0",
		"validator": "^13.15.35"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.1.0",
		"@graphql-codegen/typed-document-node": "^7.0.2",
		"@graphql-codegen/typescript": "^6.0.2",
		"@graphql-codegen/typescript-operations": "^6.0.3",
		"@parcel/watcher": "^2.5.6",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/rss": "^0.0.32",
		"@types/sanitize-html": "^2.16.1",
		"@types/uuid": "^11.0.0",
		"autoprefixer": "^10.5.0",
		"concurrently": "^9.2.1",
		"eslint": "^10.4.0",
		"eslint-config-next": "^16.2.6",
		"eslint-config-prettier": "^10.1.8",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=26.0.0"
	}
}
